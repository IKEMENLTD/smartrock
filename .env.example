# ===== sds (Self-Datsumo System) 環境変数 (design-docs/27_環境変数・設定.md) =====

# --- アプリ基本 ---
DATABASE_URL=postgresql://sds:sds@localhost:5432/sds
APP_BASE_URL=https://booking.example.com
TZ=Asia/Tokyo

# --- LINE (Messaging API + LIFF) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LIFF_ID=1234567890-abcdefgh

# --- Google Calendar (サービスアカウント) ---
# JSON文字列をそのまま入れるか、ファイルパスを指定
GOOGLE_SA_JSON=
GOOGLE_CALENDAR_ID=xxx@group.calendar.google.com

# --- SwitchBot API v1.1 ---
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
# webhook受信を許可する deviceId をカンマ区切りで列挙
SWITCHBOT_WEBHOOK_ALLOW_DEVICES=

# --- Stripe (任意 / Should) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Frigate NVR (死活監視) ---
FRIGATE_URL=http://frigate:5000

# --- 認証 (Auth.js) ---
# AUTH_SECRET と NEXTAUTH_SECRET は同じ値にすること
# (middleware の withAuth は NEXTAUTH_SECRET で JWT を検証するため)
AUTH_SECRET=please-change-me-to-a-random-32-byte-string
NEXTAUTH_SECRET=please-change-me-to-a-random-32-byte-string
NEXTAUTH_URL=http://localhost:3000

# --- 運用パラメータ (design-docs/07 既定値) ---
ADMIN_ALERT_LINE_USER_ID=
PASSCODE_VALID_BEFORE_MIN=10
PASSCODE_VALID_AFTER_MIN=15
CANCEL_DEADLINE_HOURS=24
RECORDING_RETENTION_DAYS=30

# 決済を初期スコープに含めるか (false=決済なしMVP / AS-07)
PAYMENTS_ENABLED=false
