# テスト用環境変数の雛形。`cp .env.test.example .env.test` して環境に合わせて調整。
# vitest.config.ts が .env.test を読み込む。テスト用DB(sds_test)が必要。
DATABASE_URL=postgresql://sds@127.0.0.1:5432/sds_test?schema=public
TZ=Asia/Tokyo
LINE_CHANNEL_SECRET=testsecret
SWITCHBOT_TOKEN=testtoken
SWITCHBOT_SECRET=testsecret
SWITCHBOT_WEBHOOK_ALLOW_DEVICES=KEYPAD-DEV-0001,LOCK-DEV-0001
PASSCODE_VALID_BEFORE_MIN=10
PASSCODE_VALID_AFTER_MIN=15
CANCEL_DEADLINE_HOURS=24
PAYMENTS_ENABLED=true
STRIPE_WEBHOOK_SECRET=whsec_test
AUTH_SECRET=test-secret-0123456789abcdef0123
NEXTAUTH_SECRET=test-secret-0123456789abcdef0123
